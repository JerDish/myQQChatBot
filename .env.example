# ============================================================
#  QQ + DeepSeek 聊天机器人 配置文件
#  使用方法：把本文件复制为 .env，然后填写里面的值
# ============================================================

# ---------------- DeepSeek API（必填）----------------
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat（V3，快、便宜，推荐）或 deepseek-reasoner（R1，会推理但更慢更贵）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=1.0
# 单次回复最大 token，QQ 聊天一般 512~1024 足够
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=2
# 追加在所有群都生效的额外要求（可留空）
DEEPSEEK_EXTRA_PROMPT=

# ---------------- OneBot 协议端（NapCat）----------------
# NapCat 里开启「网络配置 - 正向 WebSocket 服务器」，填它监听的地址
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 与 NapCat 中配置的 token 保持一致，没设就留空
ONEBOT_ACCESS_TOKEN=
# 可选：填了就走 HTTP API 发消息，例如 http://127.0.0.1:3000（留空则全部走 WebSocket）
ONEBOT_HTTP_API=
# 机器人 QQ 号。docker compose 会把它传给 NapCat 容器的 ACCOUNT，
# 让 QQ 以「快速登录」方式启动（被踢后重启容器有机会自动登回来）。
BOT_QQ=

# ---------------- 机器人与人格 ----------------
BOT_NAME=小深
# 默认人格文件（支持热加载，改完保存即生效）
PERSONA_FILE=config/persona.md
# 群专属人格目录：在里面放 <群号>.md 即可给单个群设定不同人格
PERSONA_DIR=config/personas

# ---------------- 响应规则 ----------------
# true = 群里只有 @机器人 才回复（需求 2）
GROUP_AT_ONLY=true
# 私聊是否直接回复
PRIVATE_ENABLED=true
# 不想理会的 QQ 号（比如其它机器人），用逗号分隔
IGNORE_USER_IDS=

# 群白名单：填了就只服务这些群（逗号分隔群号；留空 = 所有群）
GROUP_WHITELIST=
# 群黑名单：这些群一律不回复（优先级高于白名单）
GROUP_BLACKLIST=

# ---------------- 上下文记忆 ----------------
# 最多记住最近多少轮问答（1 轮 = 用户 1 条 + 机器人 1 条）
HISTORY_MAX_TURNS=12
# 记忆过期时间（秒），超过则自动遗忘
HISTORY_TTL=3600
# shared = 整个群共享一份上下文（大家能看到彼此的话）；per_user = 每人独立上下文
GROUP_MEMORY_MODE=shared
MEMORY_MAX_SESSIONS=500

# ---------------- 限流 ----------------
RATE_LIMIT_ENABLED=true
# 每人每窗口最多问几次
RATE_LIMIT_PER_USER=5
RATE_LIMIT_WINDOW=60
# 全机器人窗口内总次数上限
RATE_LIMIT_GLOBAL=60
# 被限流时是否提示对方
RATE_LIMIT_NOTIFY=true

# ---------------- 入群打招呼 / 新人欢迎 ----------------
WELCOME_ENABLED=true
# 延迟几秒发送，等系统提示先刷出来，更像真人
WELCOME_DELAY=1.5
# 需求 3：机器人被拉进新群时的打招呼语
GROUP_JOIN_GREETING=大家好，我是{bot_name}。这里……是一个新的「世界」吗～
# 需求 4：有群友加群时的欢迎语（{at} 会被替换成真正的 @）
WELCOME_TEMPLATE=欢迎 {at} 加入～ 请多指教。希望这里也能成为让你安心的世界，也希望明天对大家来说，同样美好。
# 可选：有人加机器人为好友时的私聊问候（留空 = 不发送）
FRIEND_ADD_GREETING=
# 可选：有人退群时的提示（留空 = 不发送）
LEAVE_NOTICE=

# ---------------- 戳一戳 / 表情包 ----------------
# 有人戳机器人时，回一句话
POKE_REPLY_ENABLED=true
# true = 顺便戳回去（可能变成互相戳个没完，默认关闭）
POKE_BACK=false
# 被 @ 或私聊收到的表情包，会回应一句
STICKER_REPLY_ENABLED=true
# 群里没被 @ 时，看到表情包有这一概率主动插一句（0 = 从不，保持 0 才符合「仅 @ 响应」）
STICKER_RANDOM_CHANCE=0

# ---------------- 定时播报 ----------------
# 每天定时向所有群发晚安
GOODNIGHT_ENABLED=true
# 24 小时制 HH:MM
GOODNIGHT_TIME=23:00
GOODNIGHT_TEXT=晚安，大家。祈祷明天对你来说，也是美好的一天。
# 随机延迟上限（秒）：避免每天精确到同一秒发送，太像机器人
GOODNIGHT_JITTER=180
# 每次启动向所有群发一句问候
STARTUP_GREETING_ENABLED=true
# 下面五句按「读取到的系统时间」自动切换，留空则回退到 STARTUP_GREETING
STARTUP_GREETING=我苏醒了。希望今天对你来说，也是美好的一天。
# 05:00 - 10:59
STARTUP_GREETING_MORNING=早上好，我苏醒了。希望今天对你来说，也是美好的一天。
# 11:00 - 12:59
STARTUP_GREETING_NOON=中午好，我醒了。今天也请多指教。
# 13:00 - 17:59
STARTUP_GREETING_AFTERNOON=下午好，我醒了。希望今天对你来说，也是美好的一天。
# 18:00 - 22:59
STARTUP_GREETING_EVENING=晚上好，我醒了。希望今晚对你来说，也是美好的一天。
# 23:00 - 04:59
STARTUP_GREETING_NIGHT=……这个点还没睡吗。我也醒了。希望明天对你来说，也是美好的一天。
# 启动后延迟几秒再发，等协议端完全就绪
STARTUP_GREETING_DELAY=6
# 距上次启动问候不足这么多秒就跳过，防止频繁重启刷屏（0 = 每次启动都发）
STARTUP_GREETING_MIN_INTERVAL=0


# ---------------- 指令系统 ----------------
# 以 / 或 \\ 开头的消息视为指令，不需要 @，也不经过 DeepSeek
COMMANDS_ENABLED=true
# 语音转文字（用 QQ 自带的识别，不需要第三方服务，免费）
VOICE_ENABLED=true
# 被回复的消息，读出原文再交给 AI
QUOTE_READ_ENABLED=true

# ---------------- 每日新闻播报 ----------------
NEWS_ENABLED=true
# 每天几点发新闻（24 小时制）
NEWS_TIME=10:00
# 摘要目标字数
NEWS_MAX_CHARS=200
# 随机延迟上限（秒），避免每天精确到同一秒
NEWS_JITTER=300

# ---------------- 输出格式 ----------------
# 单条消息最大字数，超出自动分段发送
MAX_REPLY_CHARS=1200
# true = 自动去掉 Markdown 标记（QQ 不渲染 Markdown）
STRIP_MARKDOWN=true
# true = 去掉消息里的空行（QQ 里空行占地方又显乱）
STRIP_BLANK_LINES=true
# true = 回复时引用对方的消息
REPLY_WITH_QUOTE=false

# ---------------- 日志 ----------------
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
